# Budget Planner — environment configuration.
# Copy to .env for local overrides. Never commit .env.

# Deployment environment. One of: dev | test | production.
# Production flips database_url defaults to /data/budget.db (ADR-0034 §2)
# and requires BUDGET_COOKIE_SECRET.
# BUDGET_ENV=dev

# SQLite URL. Dev default: sqlite:///data/budget.sqlite.
# Production default (when unset and BUDGET_ENV=production): sqlite:////data/budget.db.
# BUDGET_DATABASE_URL=sqlite:///data/budget.sqlite

# Base currency for aggregates (ISO 4217, uppercase). Default PLN. See ADR-0006.
# BUDGET_BASE_CURRENCY=PLN

# Display timezone for rendering UTC timestamps. See ADR-0007.
# BUDGET_DISPLAY_TIMEZONE=Europe/Warsaw

# Local bind for uvicorn. The validator rejects public interfaces —
# Caddy fronts TLS and the uvicorn socket must stay on loopback
# (ADR-0005 / ADR-0036).
# BUDGET_BIND_HOST=127.0.0.1
# BUDGET_BIND_PORT=8000

# Comma-separated list consumed by Starlette's TrustedHostMiddleware
# once T-D07 lands. Empty by default (middleware disabled).
# BUDGET_TRUSTED_HOSTS=budget.example.com,api.example.com

# Signed-session cookie secret. Required in production. Dev / test fall
# back to a known value and emit a warning.
# BUDGET_COOKIE_SECRET=change-me-to-a-random-value

# Session lifetime in days. 1..90 (inclusive).
# BUDGET_SESSION_LIFETIME_DAYS=14
# Hard cap from session creation; must be >= BUDGET_SESSION_LIFETIME_DAYS (ADR-0076).
# BUDGET_SESSION_ABSOLUTE_LIFETIME_DAYS=30
# Step-up re-auth window (ADR-0076 §2; T-D53b): passkey add/revoke, revoking other
# sessions and admin user actions need a login or re-auth within this many minutes.
# BUDGET_SESSION_REAUTH_WINDOW_MINUTES=10
# Re-auth attempts per signed-in user (ADR-0072 limiter, scope "reauth").
# BUDGET_RATE_LIMIT_REAUTH_PER_MINUTE=5
# BUDGET_RATE_LIMIT_REAUTH_PER_HOUR=20

# WebAuthn relying party (ADR-0067). Production: deployed hostname + https origin.
# BUDGET_WEBAUTHN_RP_ID=localhost
# BUDGET_WEBAUTHN_RP_NAME=Rising Dough
# BUDGET_WEBAUTHN_ORIGIN=http://localhost:8000

# Admin bootstrap (T-D19, ADR-0061 §3, ADR-0069). Read only when no live
# admin exists. Production: injected by cloud-init from Terraform; missing
# values with no admin → startup exits non-zero. Dev: when both are unset,
# falls back to admin@local.test / admin (only on a DB without real data).
# Note the BUDGET_PLANNER_ prefix (not BUDGET_).
# BUDGET_PLANNER_ADMIN_EMAIL=admin@example.com
# BUDGET_PLANNER_ADMIN_INITIAL_PASSWORD=

# FX rate source. See ADR-0006.
# BUDGET_FX_API_URL=https://api.frankfurter.app

# ---------------------------------------------------------------------------
# docker-compose prod-sim
# ---------------------------------------------------------------------------
# Dev-only MinIO credentials used by `just test-prod-stack` to simulate the
# Scaleway Object Storage bucket (ADR-0032 §3, ADR-0034). These values are
# baked into docker-compose.yml because the prod-sim stack is hermetic — do
# not reuse them anywhere real.
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=minio12345
