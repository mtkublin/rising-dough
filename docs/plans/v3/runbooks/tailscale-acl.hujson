// Intended Tailscale tailnet policy (T-D67, ADR-0094).
// NOT managed by Terraform (tailnet-global; both env states would own it).
// Paste in the admin console: Access controls -> edit file. Replace the owner
// placeholder with your Tailscale login email before saving.
{
	// Who may apply each tag. A Tailscale OAuth client acts as a tagged identity
	// that carries its own tags, and it can only mint auth keys for tags it owns.
	// The OAuth client therefore carries only tag:automation (scope Auth Keys:
	// write), and tag:automation owns the tags it mints keys for. Without this
	// owner chain, single-tag keys fail with "requested tags [tag:drill] are
	// invalid or not permitted (400)". tag:automation is ownership-only: no
	// device carries it.
	"tagOwners": {
		"tag:automation": ["you@example.com"],
		"tag:prod":       ["you@example.com", "tag:automation"],
		"tag:drill":      ["you@example.com", "tag:automation"],
		"tag:ci":         ["you@example.com", "tag:automation"],
	},

	// Default-deny: only the rules below allow traffic.
	"acls": [
		// Operator's own devices -> SSH on prod and drill.
		{
			"action": "accept",
			"src":    ["you@example.com"],
			"dst":    ["tag:prod:22", "tag:drill:22"],
		},
		// GitHub Actions runners -> SSH on prod and drill.
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst":    ["tag:prod:22", "tag:drill:22"],
		},
	],
}
