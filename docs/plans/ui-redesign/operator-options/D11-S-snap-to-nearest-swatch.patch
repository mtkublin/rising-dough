+def _rgb(hex_value: str) -> tuple[int, int, int]:
+    return int(hex_value[1:3], 16), int(hex_value[3:5], 16), int(hex_value[5:7], 16)
+
+
+def _nearest_swatch(hex_value: str) -> str:
+    """The dialog swatch closest to a stored hue (RGB distance).
+
+    The dialog palette (ten swatches) is not the board palette: Takeaway is stored as the board's
+    ``orange`` (#ff9f43), which no swatch holds; the handoff dialog shows its neighbour, ``tangerine``.
+    """
+    want = _rgb(hex_value)
+    return min(
+        _FORM_SWATCH_NAMES,
+        key=lambda name: sum((a - b) ** 2 for a, b in zip(_rgb(_PRESET_HEX[name]), want, strict=True)),
+    )
+
