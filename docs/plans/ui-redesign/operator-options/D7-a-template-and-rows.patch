+# --- D7 / force-password: the board signs in `parent@example.test`; the seed's user who owes a new
+# password (modifier owner-must-change) is the owner.
+
+[[row]]
+page = "pages/auth/force-password*.html"
+select = ".rd-auth__form > .rd-caption"
+field = "text"
+old = "signed in as parent@example.test"
+value = "signed in as owner@example.test"
+reason = "handoff data: the board's forced user is parent@example.test, the harness signs in the seed owner (owner-must-change)"
+
+[[row]]
+page = "pages/auth/force-password--error.html"
+select = "#confirm-password-error"
+field = "text"
+old = "▲ Passwords don’t match"
+value = "▲ The two new passwords don't match."
