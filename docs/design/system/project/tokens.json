{
  "name": "Rising Dough Sourdough",
  "version": 1,
  "meta": {
    "source": "docs/design/rising-dough-frontend/static/css/tokens.css"
  },
  "color": {
    "themes": [
      {
        "id": "light",
        "name": "Light"
      },
      {
        "id": "dark",
        "name": "Dark"
      }
    ],
    "tokens": [
      {
        "name": "color-ground",
        "value": {
          "light": "#fff",
          "dark": "#0d0d0b"
        },
        "usage": "Page ground. Light: plain white. Dark: near-black."
      },
      {
        "name": "color-panel",
        "value": {
          "light": "#faf7f3",
          "dark": "#161613"
        },
        "usage": "The panel that rises under the bake field; sheets and dialogs. A whisper warmer than ground in light."
      },
      {
        "name": "color-raised",
        "value": {
          "light": "#f3eee7",
          "dark": "#1d1d19"
        },
        "usage": "Raised surfaces inside a panel: inputs, hovered rows, segmented tracks."
      },
      {
        "name": "color-rule",
        "value": {
          "light": "#ece6de",
          "dark": "#2a2a26"
        },
        "usage": "1px hairlines between data rows and around fields."
      },
      {
        "name": "color-ink",
        "value": {
          "light": "#121010",
          "dark": "#edede6"
        },
        "usage": "Text on ground and panel."
      },
      {
        "name": "color-ink-muted",
        "value": {
          "light": "#635c55",
          "dark": "#8a8a80"
        },
        "usage": "Labels, axes, timestamps, empty bar cells (about 6:1 on panel in both themes)."
      },
      {
        "name": "color-bake",
        "value": {
          "light": "#ffe9db",
          "dark": "#ff5a1f"
        },
        "usage": "The hero field, one per screen. Light: pale apricot. Dark: full oven orange."
      },
      {
        "name": "color-crumb",
        "value": {
          "light": "#ec5815",
          "dark": "#802908"
        },
        "usage": "ASCII loaf texture printed on the bake field. Decorative only, never text; 3:1 on bake."
      },
      {
        "name": "color-ink-deep",
        "value": {
          "light": "#121010",
          "dark": "#0d0d0b"
        },
        "usage": "Text on bake and on now-fill, in both themes."
      },
      {
        "name": "color-now",
        "value": {
          "light": "#b33a0a",
          "dark": "#d7ff5c"
        },
        "usage": "The current thing and growth, as text: positive deltas, the current period label, savings figures. Light: burnt orange. Dark: lime."
      },
      {
        "name": "color-now-fill",
        "value": {
          "light": "#ff5a1f",
          "dark": "#d7ff5c"
        },
        "usage": "Solid fill for the current thing: the current loaf bar, the selected chip, the primary button on panel. Text on it is ink-deep."
      },
      {
        "name": "color-now-edge",
        "value": {
          "light": "#c9400c",
          "dark": "#d7ff5c"
        },
        "usage": "1px ring around every now-fill shape (`--ring-now`). Light: gives oven orange 4.7:1 on panel. Dark: same as now-fill, so invisible."
      },
      {
        "name": "color-past",
        "value": {
          "light": "#ffdcc6",
          "dark": "#2a2a26"
        },
        "usage": "Past-period loaf bars. Decorative."
      },
      {
        "name": "color-over",
        "value": {
          "light": "#a3154d",
          "dark": "#ff4f8b"
        },
        "usage": "Overspend, text-safe on ground and panel. Light: deep berry. Dark: pink. Never reads as progress."
      },
      {
        "name": "color-annotation",
        "value": {
          "light": "#d9d2c8",
          "dark": "#3a3a34"
        },
        "usage": "Design annotations and dashed guides on component boards; not used in app screens."
      },
      {
        "name": "color-scrim",
        "value": {
          "light": "rgb(18 16 16 / 40%)",
          "dark": "rgb(0 0 0 / 62%)"
        },
        "usage": "Backdrop behind dialogs and sheets."
      }
    ]
  },
