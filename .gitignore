# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Env
.env
.env.local

# Database — SQLite file + WAL/SHM sidecars + journal
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# Everything under data/ is ignored by default (prod DB, exports, backups).
# Exceptions below keep the anonymized demo DB and build_demo_db.py tracked.
# WAL/SHM sidecars still match the *.sqlite-wal / *.sqlite-shm rules above.
data/*
!data/.gitkeep
!data/demo.sqlite
!data/scripts/
data/scripts/*
!data/scripts/build_demo_db.py

# Build artifacts
dist/
build/
*.egg-info/

# Secrets baseline (keep .secrets.baseline tracked)
.secrets.baseline.local

# Claude Code local-only settings (keep .claude/skills/** tracked)
.claude/settings.local.json

# Node toolchain (dev-only, see ADR-0027)
node_modules/

# Visual-audit artifacts
/tmp-fe-audit/

# scripts/dump_schema.sh scratch dirs (regeneration workspace)
.schema_dump.*/

# Local-only scratch dir (research, drafts, non-tracked artifacts)
/local/

# Claude Code worktrees (ephemeral per-agent working copies)
.claude/worktrees/
