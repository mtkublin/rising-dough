# Operator values for the prod environment. Gitignored (terraform/.gitignore).
# Built from terraform.tfvars.example. Never put secret values here; the
# Scaleway API key goes through 'scw init' / env vars, and the GHCR PAT through
# TF_VAR_ghcr_pull_pat (see terraform/README.md).
#
# Scaleway organization name: mk-personal   (Terraform uses the ID below, not the name)
# Scaleway project name:      rising-dough   (ADR-0092: org default project)
#
# TODO markers: anything still marked TODO must be filled in before 'terraform apply'.

env         = "prod"
admin_email = "mtkublin@gmail.com" # bootstrap admin email (checklist D3)
# rising-dough, the org default project; ADR-0092: each env lives in its own project.
scaleway_project_id      = "53175dd0-b944-489b-b05d-3f55d65d79af"
scaleway_organization_id = "53175dd0-b944-489b-b05d-3f55d65d79af"
scaleway_region          = "pl-waw"
scaleway_zone            = "pl-waw-2" # ADR-0084; re-check Stardust stock before apply

domain         = "rising-dough.eu" # bought 2026-11-04
subdomain_prod = "budget"
# ADR-0088: zone at Scaleway DNS, env manages only its records
managed_dns_zone = true
# Project that owns the DNS zone = PROD project (rising-dough). Records of BOTH envs are created there (ADR-0092).
dns_zone_project_id = "53175dd0-b944-489b-b05d-3f55d65d79af"

app_image_tag = "main"
github_owner  = "mtkublin"

# Public keys only (checklist A4).
operator_ssh_pubkey  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILhGk8BFW27nhS35L5v0tzWdpcMPVZhMc4qBlw35wpMJ mtkublin@gmail.com"
github_deploy_pubkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOMO/UapumrKg4LkKX/Q3O2wMbyipDhIHXCx62wI85R/ mtkublin@gmail.com"

# Bucket policy (ADR-0091): your Scaleway user id (scw iam user list).
bucket_admin_principals = ["user_id:ec0a79d3-4368-4663-9555-c704d3d47d40"]

# Prod only: extra read-only principals. The stable restore-reader application
# (ADR-0092) is added automatically; leave empty normally.
bucket_readonly_principals = []
