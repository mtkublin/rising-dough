# ----------------------------------------------------------------------------
# Admin bootstrap + app secrets (ADR-0061 §3, ADR-0035 §6).
# These values are generated by Terraform, surfaced via sensitive outputs,
# and injected into the VM via cloud-init only. They are never written to
# disk outside the compose service env.
# ----------------------------------------------------------------------------

resource "random_password" "admin_initial_password" {
  length  = 24
  special = false
}

resource "random_password" "cookie_secret" {
  length  = 48
  special = false
}

# T-D84: drill-only serial-console password for `operator` (ADR-0094). Only the
# bcrypt hash reaches user-data; the plaintext is exposed solely via the sensitive
# `console_password` output.
resource "random_password" "console" {
  count   = var.break_glass_console_password ? 1 : 0
  length  = 24
  special = false
}

# ----------------------------------------------------------------------------
# Module composition.
# ----------------------------------------------------------------------------

# T-D103 / ADR-0104: the app and restore-reader identities moved to
# terraform/bootstrap/ci. Forget them here without deleting them.
removed {
  from = module.iam

  lifecycle {
    destroy = false
  }
}

removed {
  from = module.restore_reader

  lifecycle {
    destroy = false
  }
}

module "storage" {
  source = "./modules/storage"

  bucket_name     = local.bucket_name
  scaleway_region = var.scaleway_region
  lifecycle_days  = local.lifecycle_days # T-D57: backup_max_age_days - 30 d Litestream retention

  # T-D86: expire boot-logs/ after 7 d on drill only (prod bucket unchanged).
  expire_boot_logs = var.env == "drill"

  # ADR-0091: allow-list policy + drill-only force_destroy.
  env_application_id  = var.app_application_id
  admin_principals    = var.bucket_admin_principals
  readonly_principals = local.bucket_readonly_principals # ADR-0092: + restore-reader on prod
  plan_principals     = var.bucket_plan_principals       # ADR-0105: ci-plan on prod
  force_destroy       = var.env == "drill"
}

# T-D69 / ADR-0092: the long-lived restore-reader principal is read-only on the
# prod bucket. It lives in terraform/bootstrap/ci (ADR-0104); prod only.
locals {
  # T-D137: the CI key is authorised on drill hosts only. Structural: on any
  # other env the value collapses to "" before it reaches the compute module.
  ci_ssh_pubkey_effective = var.env == "drill" ? var.ci_ssh_pubkey : ""

  bucket_readonly_principals = distinct(concat(
    var.bucket_readonly_principals,
    var.restore_reader_application_id == "" ? [] : ["application_id:${var.restore_reader_application_id}"],
  ))
}

# ADR-0101: the drill is tailnet-only and creates no DNS records (prod only).
module "dns" {
  source = "./modules/dns"
  count  = local.tailnet_only ? 0 : 1

  managed_zone    = var.managed_dns_zone
  zone_project_id = var.dns_zone_project_id
  domain          = var.domain
  subdomain       = local.subdomain
  instance_ipv4   = module.compute.vm_ipv4
  instance_ipv6   = module.compute.vm_ipv6
  record_ttl_secs = 300
}

# The module became conditional (T-D97); keep the existing prod records.
moved {
  from = module.dns
  to   = module.dns[0]
}

# ----------------------------------------------------------------------------
# T-D67 / ADR-0094: single-use, pre-authorized, tag-bound Tailscale auth key.
# Drill nodes are ephemeral: they vanish from the tailnet shortly after destroy.
# The tailnet ACL is NOT managed here (tailnet-global; see runbooks/tailscale-acl.hujson).
# ----------------------------------------------------------------------------

# T-D156 / ADR-0127: everything that forces a VM replacement. The key is
# single-use and expires after an hour, so a new VM needs a new key. Tailscale
# keys cannot be updated in place: putting the spec hash in the description
# replaces the key in the same plan that replaces the server. (The key cannot
# reference the server: the server's user_data carries the key.)
locals {
  vm_spec = {
    # T-D123: STARDUST1-S quota is 1 per organisation (prod). Drill uses another type.
    instance_type = var.env == "prod" ? "STARDUST1-S" : var.drill_instance_type
    image         = "ubuntu_noble"
    zone          = var.scaleway_zone
    # ADR-0127 §7: the replacement rehearsal boots the drill on Block Storage
    # (as prod before T-D143) and then moves it to l_ssd. Prod is always l_ssd.
    root_volume_type    = var.env == "prod" ? "l_ssd" : var.drill_root_volume_type
    root_volume_size_gb = 10
  }
  vm_spec_id = substr(sha256(jsonencode(local.vm_spec)), 0, 12)
}

resource "tailscale_tailnet_key" "vm" {
  description   = "budget-planner-${var.env} first boot vm ${local.vm_spec_id}"
  reusable      = false
  ephemeral     = var.env == "drill"
  preauthorized = true
  expiry        = 3600
  tags          = [local.tailscale_tag]
}

module "compute" {
  source = "./modules/compute"

  # T-D156 / ADR-0127: every replacement-forcing input comes from local.vm_spec.
  instance_type       = local.vm_spec.instance_type
  image               = local.vm_spec.image
  scaleway_zone       = local.vm_spec.zone
  root_volume_type    = local.vm_spec.root_volume_type
  root_volume_size_gb = local.vm_spec.root_volume_size_gb

  name_prefix = local.name_prefix
  # ADR-0111: tag@digest; CI passes the previous ref read from state.
  app_image_ref          = var.app_image_ref
  app_image_previous_ref = var.app_image_previous_ref
  hostname               = local.fqdn
  bucket_name            = module.storage.bucket_name
  bucket_endpoint        = module.storage.endpoint_url
  bucket_region          = var.scaleway_region
  scw_access_key         = var.app_scw_access_key
  scw_secret_key         = var.app_scw_secret_key
  operator_ssh_pub       = var.operator_ssh_pubkey
  ci_ssh_pub             = local.ci_ssh_pubkey_effective
  ghcr_pull_pat          = var.ghcr_pull_pat
  github_owner           = var.github_owner
  github_repo            = var.github_repo
  admin_email            = var.admin_email
  admin_password         = random_password.admin_initial_password.result
  cookie_secret          = random_password.cookie_secret.result
  trusted_hosts_csv      = local.fqdn

  # T-D97 / ADR-0101: drill = tailnet only (no public 80/443, Caddy cert from tailscaled).
  tailnet_only = local.tailnet_only

  # T-D67: SSH only over Tailscale.
  tailscale_authkey  = tailscale_tailnet_key.vm.key
  tailscale_hostname = local.tailscale_hostname
  tailscale_tag      = local.tailscale_tag

  # T-D81: drill-only break-glass public SSH (empty by default; prod forbidden).
  break_glass_ssh_cidrs = var.break_glass_ssh_cidrs

  # T-D84: drill-only console break-glass (bcrypt hash only; empty = disabled).
  console_password_hash = var.break_glass_console_password ? random_password.console[0].bcrypt_hash : ""

  # T-D86: drill-only boot log upload to the drill bucket (false = nothing rendered).
  boot_log_upload = var.boot_log_upload

  # T-D90: drill TTL, read by the sweeper from the server tags ("" = no tag).
  expires_at = var.drill_expires_at

  # T-D41a: restore-from-prod helper, drill env only.
  enable_restore_helper  = var.env == "drill"
  restore_source_bucket  = "budget-planner-prod-${var.scaleway_region}"
  scw_access_key_restore = var.env == "drill" ? var.scw_access_key_restore : ""
  scw_secret_key_restore = var.env == "drill" ? var.scw_secret_key_restore : ""

  # T-D56: Litestream replica age encryption (ADR-0078 §3).
  litestream_age_identity  = var.litestream_age_identity
  litestream_age_recipient = var.litestream_age_recipient

  # T-D156 / ADR-0127: the drill bucket starts empty; prod must restore or fail.
  # The rehearsal (§7) turns it off on the drill once to prove the refusal.
  allow_empty_db = var.env == "drill" ? var.drill_allow_empty_db : var.allow_empty_db

  # T-D57: single knob; also drives the app container env.
  backup_max_age_days = var.backup_max_age_days
}
