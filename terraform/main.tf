# ----------------------------------------------------------------------------
# Admin bootstrap + app secrets (ADR-0061 §3, ADR-0035 §6).
# These values are generated by Terraform, surfaced via sensitive outputs,
# and injected into the VM via cloud-init only. They are never written to
# disk outside the compose service env.
# ----------------------------------------------------------------------------

resource "random_password" "admin_initial_password" {
  length  = 24
  special = false
}

resource "random_password" "cookie_secret" {
  length  = 48
  special = false
}

# ----------------------------------------------------------------------------
# Module composition.
# ----------------------------------------------------------------------------

module "iam" {
  source = "./modules/iam"

  name_prefix         = local.name_prefix
  scaleway_project_id = var.scaleway_project_id
}

module "storage" {
  source = "./modules/storage"

  bucket_name       = local.bucket_name
  scaleway_region   = var.scaleway_region
  lifecycle_days    = 30
  log_bucket_suffix = "logs"

  # ADR-0091: allow-list policy + drill-only force_destroy.
  env_application_id  = module.iam.application_id
  admin_principals    = var.bucket_admin_principals
  readonly_principals = var.bucket_readonly_principals
  force_destroy       = var.env == "drill"
}

module "dns" {
  source = "./modules/dns"

  managed_zone    = var.managed_dns_zone
  domain          = var.domain
  subdomain       = local.subdomain
  instance_ipv4   = module.compute.vm_ipv4
  instance_ipv6   = module.compute.vm_ipv6
  record_ttl_secs = 300
}

module "compute" {
  source = "./modules/compute"

  name_prefix       = local.name_prefix
  scaleway_zone     = var.scaleway_zone
  app_image_tag     = var.app_image_tag
  hostname          = local.fqdn
  bucket_name       = module.storage.bucket_name
  bucket_endpoint   = module.storage.endpoint_url
  bucket_region     = var.scaleway_region
  scw_access_key    = module.iam.access_key
  scw_secret_key    = module.iam.secret_key
  operator_ssh_pub  = var.operator_ssh_pubkey
  deploy_ssh_pub    = var.github_deploy_pubkey
  ghcr_pull_pat     = var.ghcr_pull_pat
  github_owner      = var.github_owner
  admin_email       = var.admin_email
  admin_password    = random_password.admin_initial_password.result
  cookie_secret     = random_password.cookie_secret.result
  trusted_hosts_csv = local.fqdn

  # T-D41a: restore-from-prod helper, drill env only.
  enable_restore_helper  = var.env == "drill"
  restore_source_bucket  = "budget-planner-prod-${var.scaleway_region}"
  scw_access_key_restore = var.env == "drill" ? var.scw_access_key_restore : ""
  scw_secret_key_restore = var.env == "drill" ? var.scw_secret_key_restore : ""

  # T-D56: Litestream replica age encryption (ADR-0078 §3).
  litestream_age_identity  = var.litestream_age_identity
  litestream_age_recipient = var.litestream_age_recipient
}
